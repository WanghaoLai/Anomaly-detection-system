{
  "name": "实验室 GPU 服务器知识库真实问答集",
  "version": 1,
  "description": "根据当前服务器用户手册整理的 40 条真实使用问题；expected_all 用于判断召回分块是否包含回答依据。",
  "questions": [
    {"id": "q01", "category": "semantic", "question": "第一次连接实验室服务器需要经过哪些阶段？", "expected_all": ["ZeroTier", "SSH"]},
    {"id": "q02", "category": "semantic", "question": "开始接入服务器前需要向管理员获取哪些信息？", "expected_all": ["planet", "SSH 端口"]},
    {"id": "q03", "category": "exact", "question": "Windows 上的 ZeroTier planet 文件放在哪个目录？", "expected_all": ["C:\\ProgramData\\ZeroTier\\One", "planet"]},
    {"id": "q04", "category": "semantic", "question": "Windows 替换 planet 文件后如何让配置生效？", "expected_all": ["ZeroTier One", "重新启动服务"]},
    {"id": "q05", "category": "semantic", "question": "加入 ZeroTier 网络后为什么还不能立即登录服务器？", "expected_all": ["设备 ID", "管理员批准"]},
    {"id": "q06", "category": "exact", "question": "macOS 的 ZeroTier planet 文件路径是什么？", "expected_all": ["/Library/Application Support/ZeroTier/One/planet"]},
    {"id": "q07", "category": "exact", "question": "macOS 怎么查看 ZeroTier 设备 ID 和网络状态？", "expected_all": ["zerotier-cli info", "zerotier-cli listnetworks"]},
    {"id": "q08", "category": "exact", "question": "使用指定端口进行 SSH 登录的命令格式是什么？", "expected_all": ["ssh -p", "用户名"]},
    {"id": "q09", "category": "semantic", "question": "第一次登录后输入新密码时为什么没有字符显示？", "expected_all": ["不会显示星号或字符"]},
    {"id": "q10", "category": "exact", "question": "登录服务器后应该执行哪些基础检查命令？", "expected_all": ["whoami", "hostname", "nvidia-smi", "df -h"]},
    {"id": "q11", "category": "semantic", "question": "提交训练任务前应该重点查看哪些 GPU 状态？", "expected_all": ["GPU-Util", "Memory-Usage", "Processes"]},
    {"id": "q12", "category": "semantic", "question": "LXD 容器里的 sudo 权限允许修改宿主机驱动吗？", "expected_all": ["LXD", "NVIDIA 驱动"]},
    {"id": "q13", "category": "exact", "question": "为什么服务器上不建议执行 apt upgrade？", "expected_all": ["apt upgrade", "内核"]},
    {"id": "q14", "category": "exact", "question": "每个用户默认有多少服务器存储空间？", "expected_all": ["400 GB"]},
    {"id": "q15", "category": "exact", "question": "如何查看磁盘剩余空间和各目录占用？", "expected_all": ["df -h", "du -sh"]},
    {"id": "q16", "category": "semantic", "question": "不同项目为什么应该创建独立的 Conda 环境？", "expected_all": ["每个项目创建独立环境"]},
    {"id": "q17", "category": "semantic", "question": "安装 PyTorch 时需要和哪些 CUDA 环境信息匹配？", "expected_all": ["PyTorch", "CUDA"]},
    {"id": "q18", "category": "exact", "question": "怎么用 Python 验证 PyTorch 是否识别到 GPU？", "expected_all": ["torch.cuda.is_available()", "torch.cuda.get_device_name"]},
    {"id": "q19", "category": "exact", "question": "公共 CUDA 安装包和切换方法存放在哪里？", "expected_all": ["/home/share/CUDA/"]},
    {"id": "q20", "category": "semantic", "question": "共享目录中的文件对其他用户是否可见？", "expected_all": ["/home/share/", "全员可见"]},
    {"id": "q21", "category": "exact", "question": "大型数据集应该怎样下载，推荐哪些工具？", "expected_all": ["wget", "gdown", "bypy"]},
    {"id": "q22", "category": "exact", "question": "服务器网络代理工具 gg 在哪里？", "expected_all": ["~/tools/gg"]},
    {"id": "q23", "category": "exact", "question": "GitHub 下载慢时手册提供了哪个镜像站？", "expected_all": ["ghproxy.link"]},
    {"id": "q24", "category": "exact", "question": "SSH 断开后如何让 train.py 继续后台运行？", "expected_all": ["nohup python train.py", "train.log"]},
    {"id": "q25", "category": "exact", "question": "后台训练启动后怎样查看日志和进程号？", "expected_all": ["echo $!", "tail"]},
    {"id": "q26", "category": "exact", "question": "手册推荐使用哪些平台记录训练实验？", "expected_all": ["Weights & Biases", "SwanLab"]},
    {"id": "q27", "category": "semantic", "question": "任务提交记录中建议保存哪些环境和代码信息？", "expected_all": ["Git 提交号", "PyTorch/CUDA"]},
    {"id": "q28", "category": "semantic", "question": "为什么推荐使用 SSH 密钥而不是密码登录？", "expected_all": ["SSH 密钥", "密码"]},
    {"id": "q29", "category": "exact", "question": "怎样配置 Host lab-4090 以便用别名登录？", "expected_all": ["Host lab-4090", "IdentityFile"]},
    {"id": "q30", "category": "exact", "question": "如何每两秒持续刷新 GPU 使用情况？", "expected_all": ["watch -n 2 nvidia-smi"]},
    {"id": "q31", "category": "semantic", "question": "ZeroTier 一直连不上时应该检查哪些事项？", "expected_all": ["设备 ID", "防火墙"]},
    {"id": "q32", "category": "exact", "question": "SSH 的 Connection timed out 和 Connection refused 分别应该排查什么？", "expected_all": ["Connection timed out", "Connection refused"]},
    {"id": "q33", "category": "exact", "question": "SSH 提示 Permission denied 时应该检查什么？", "expected_all": ["Permission denied", "公钥"]},
    {"id": "q34", "category": "exact", "question": "遇到 Host key changed 可以直接忽略吗？", "expected_all": ["Host key changed", "联系管理员核实"]},
    {"id": "q35", "category": "semantic", "question": "nvidia-smi 正常但 torch.cuda.is_available() 为 false 怎么排查？", "expected_all": ["which python", "torch.cuda.is_available()"]},
    {"id": "q36", "category": "exact", "question": "怎样让 SSH 输出详细连接日志用于排查？", "expected_all": ["ssh -vvv"]},
    {"id": "q37", "category": "semantic", "question": "磁盘空间不足时应该优先清理哪些内容？", "expected_all": ["缓存", "中间结果"]},
    {"id": "q38", "category": "semantic", "question": "新用户开始训练前需要完成哪些环境检查？", "expected_all": ["独立 Conda 环境", "torch.cuda.is_available()"]},
    {"id": "q39", "category": "semantic", "question": "哪些服务器配置变化后需要同步更新知识库文档？", "expected_all": ["公共 CUDA 版本", "任务表单"]},
    {"id": "q40", "category": "semantic", "question": "服务器地址、账户和内部流程可以发布到公开仓库吗？", "expected_all": ["不得", "公开平台"]}
  ]
}
