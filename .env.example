# 复制为 .env 后填写本地真实配置，不要提交 .env

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ad_system
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_POOL_MINSIZE=1
MYSQL_POOL_MAXSIZE=10
MYSQL_CHARSET=utf8mb4
MYSQL_ECHO=false

# JWT
# 必填，至少 32 字节。可使用：python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
# 生产 HTTPS 环境必须设为 true
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

# 登录限流
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCK_SECONDS=900

# 逗号分隔；使用认证 Cookie 时不能配置为 *
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DashScope / 通义千问
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-turbo
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2
AI_LLM_TIMEOUT_SECONDS=45
AI_LLM_MAX_RETRIES=2
AI_LLM_RETRY_BACKOFF_SECONDS=0.4
AI_LLM_CIRCUIT_FAILURE_THRESHOLD=5
AI_LLM_CIRCUIT_RECOVERY_SECONDS=30
AI_MAX_HISTORY=20
AI_TOP_K=3
# RAG 检索：先召回 8 条，经阈值和去重后最多保留 4 条
AI_RAG_CANDIDATE_K=8
AI_RAG_DENSE_CANDIDATE_K=50
AI_RAG_LEXICAL_CANDIDATE_K=50
AI_RAG_CANDIDATE_UNION_LIMIT=100
AI_RAG_FINAL_K=4
AI_RAG_RERANK_FINAL_K=8
AI_RAG_SCORE_THRESHOLD=0.20
AI_RAG_HYBRID_ENABLED=true
AI_RAG_ACL_PUSHDOWN_ENABLED=true
AI_RAG_BM25_ENABLED=true
# 生产开启前必须预下载本地 Cross-Encoder 模型并安装 sentence-transformers
AI_RAG_RERANKER_ENABLED=false
AI_RAG_RERANKER_MODEL=
AI_RAG_RERANKER_TIMEOUT_SECONDS=2
AI_RAG_AUDIT_ENABLED=true
AI_RAG_LEXICAL_MIN_SCORE=0.08
AI_RAG_CONTEXT_TOKENS=2800
# P4 Context Packing：每条正文软预算、近重复阈值和离线 Precision 门槛
AI_RAG_CONTEXT_MIN_NODE_TOKENS=48
AI_RAG_CONTEXT_MAX_NODE_TOKENS=420
AI_RAG_CONTEXT_DUPLICATE_SIMILARITY=0.92
AI_RAG_CONTEXT_PRECISION_TARGET=0.70
AI_RAG_FAITHFULNESS_THRESHOLD=0.90
AI_RAG_CLAIM_LEXICAL_SUPPORT=0.30
# 模型 JSON 缺字段或校验失败时的受控重生成次数（最多 1 次）
AI_RAG_GROUNDING_VALIDATION_RETRIES=1
AI_RAG_QUERY_HISTORY_TURNS=2
# RAG Markdown 语义分块：Token 上限与完整段落重叠预算
AI_RAG_CHUNK_TOKENS=500
AI_RAG_OVERLAP_TOKENS=50
# 后端强制限制，不依赖浏览器校验（默认 20MB）
AI_RAG_MAX_UPLOAD_BYTES=20971520
# 原始文件、统一文档 DocStore 和 RAG 发布清单（默认 fastapi-app/files/knowledge）
AI_RAG_ARTIFACT_PATH=
AI_EMBEDDING_BATCH_SIZE=25
AI_EMBEDDING_MAX_RETRIES=3
AI_EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
AI_RAG_INGESTION_CONCURRENCY=1

# 可选：Agent 实验代码使用；按需填写，不要提交真实密钥
TAVILY_API_KEY=
SERPAPI_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
XIAOMI_MIMO_MODEL=
XIAOMI_MIMO_API_KEY=
XIAOMI_MIMO_BASE_URL=

# 远程 GPU 服务器（推荐使用只读 SSH 密钥）
GPU_SERVER_HOST=192.0.2.10
GPU_SERVER_PORT=22
GPU_SERVER_SSH_USER=gpu_observer
GPU_SERVER_SSH_PASSWORD=
GPU_SERVER_PRIVATE_KEY_PATH=/absolute/path/to/gpu_observer_key
GPU_SERVER_KNOWN_HOSTS_PATH=/absolute/path/to/known_hosts
GPU_SERVER_CONNECT_TIMEOUT=5
GPU_SERVER_COMMAND_TIMEOUT=8
GPU_STATUS_CACHE_SECONDS=5
GPU_EXPECTED_COUNT=4
GPU_ACCOUNT_ROOT_TEMPLATE=/home/{username}
# 同名 Linux 账号使用 {}；所有系统用户共用 user 时使用 {"*":"user"}
GPU_ACCOUNT_MAP_JSON={}
# 只会展示下列白名单目录，可继续添加键值对
GPU_ACCOUNT_ALLOWED_DIRECTORIES_JSON='{"项目目录":"/home/{username}/projects","数据集目录":"/data/{username}/datasets"}'
GPU_FILE_MAX_ENTRIES=5000
# 管理员 Conda 环境列表：仅扫描这些受信任的环境总目录
GPU_CONDA_ENV_ROOTS_JSON='{"系统 Conda 环境":"/opt/conda/envs"}'
GPU_CONDA_ENV_MAX_ENTRIES=500

# 阶段 1：远程训练执行器（必须使用无 sudo/docker 权限的独立账号）
TRAINING_EXECUTOR_ENABLED=false
TRAINING_SERVER_HOST=192.0.2.10
TRAINING_SERVER_PORT=22
TRAINING_SERVER_SSH_USER=adtrainer
TRAINING_SERVER_PRIVATE_KEY_PATH=/absolute/path/to/adtrainer_key
TRAINING_SERVER_KNOWN_HOSTS_PATH=/absolute/path/to/known_hosts
TRAINING_CONNECT_TIMEOUT=8
TRAINING_COMMAND_TIMEOUT=20
TRAINING_MONITOR_INTERVAL_SECONDS=2
TRAINING_MAX_PENDING_JOBS_PER_USER=3
TRAINING_MAX_CONCURRENT_JOBS=4
TRAINING_MAX_RUNTIME_SECONDS=21600
TRAINING_ARTIFACT_RETENTION_DAYS=30
TRAINING_MIN_FREE_GPU_MEMORY_MB=8000
TRAINING_REMOTE_CONTROL_ROOT=/home/adtrainer/training-control
TRAINING_REMOTE_OUTPUT_ROOT=/home/adtrainer/training-runs
TRAINING_REMOTE_RUNNER_PATH=/home/adtrainer/bin/phase0_pbas_runner_dataset_v2.py
TRAINING_GPU_ALLOWLIST=0,1,2,3

# PBAS 推理：对成功训练 checkpoint 执行官方 --test test 数据集评估流程
INFERENCE_REMOTE_RUNNER_PATH=/home/adtrainer/bin/phase0_pbas_inference_runner.py
INFERENCE_REMOTE_CONTROL_ROOT=/home/adtrainer/inference-control
INFERENCE_REMOTE_OUTPUT_ROOT=/home/adtrainer/inference-runs
INFERENCE_MAX_CONCURRENT_JOBS=2
INFERENCE_MAX_PENDING_JOBS_PER_USER=3
INFERENCE_MAX_RUNTIME_SECONDS=1800
