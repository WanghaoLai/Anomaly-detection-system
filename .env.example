# 复制为 .env 后填写本地真实配置，不要提交 .env

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ad_system
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_POOL_MINSIZE=1
MYSQL_POOL_MAXSIZE=10
MYSQL_CHARSET=utf8mb4
MYSQL_ECHO=false

# JWT
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# DashScope / 通义千问
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen-turbo
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2
AI_MAX_HISTORY=20
AI_TOP_K=3

# 可选：Agent 实验代码使用
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
XIAOMI_MIMO_MODEL=mimo-v2.5-pro
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_api_key_here
XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
