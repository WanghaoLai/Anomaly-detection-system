# 复制为 .env 后填写本地真实配置，不要提交 .env

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ad_system
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_POOL_MINSIZE=1
MYSQL_POOL_MAXSIZE=10
MYSQL_CHARSET=utf8mb4
MYSQL_ECHO=false

# JWT
# 必填，至少 32 字节。可使用：python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
# 生产 HTTPS 环境必须设为 true
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

# 登录限流
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCK_SECONDS=900

# 逗号分隔；使用认证 Cookie 时不能配置为 *
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DashScope / 通义千问
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen-turbo
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2
AI_MAX_HISTORY=20
AI_TOP_K=3

# 远程 GPU 服务器（推荐使用只读 SSH 密钥）
GPU_SERVER_HOST=192.0.2.10
GPU_SERVER_PORT=22
GPU_SERVER_SSH_USER=gpu_observer
GPU_SERVER_SSH_PASSWORD=
GPU_SERVER_PRIVATE_KEY_PATH=/absolute/path/to/gpu_observer_key
GPU_SERVER_KNOWN_HOSTS_PATH=/absolute/path/to/known_hosts
GPU_SERVER_CONNECT_TIMEOUT=5
GPU_SERVER_COMMAND_TIMEOUT=8
GPU_STATUS_CACHE_SECONDS=5
GPU_EXPECTED_COUNT=4
GPU_ACCOUNT_ROOT_TEMPLATE=/home/{username}
# 同名 Linux 账号使用 {}；所有系统用户共用 user 时使用 {"*":"user"}
GPU_ACCOUNT_MAP_JSON={}
# 只会展示下列白名单目录，可继续添加键值对
GPU_ACCOUNT_ALLOWED_DIRECTORIES_JSON='{"项目目录":"/home/{username}/projects","数据集目录":"/data/{username}/datasets"}'
GPU_FILE_MAX_ENTRIES=5000

# 可选：Agent 实验代码使用
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
XIAOMI_MIMO_MODEL=mimo-v2.5-pro
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_api_key_here
XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
