# Copy to /etc/anomaly-detection-system/app.env and fill secrets out of band.

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ad_system
MYSQL_USER=ad_system
MYSQL_PASSWORD=
MYSQL_POOL_MINSIZE=2
MYSQL_POOL_MAXSIZE=10
MYSQL_CHARSET=utf8mb4
MYSQL_ECHO=false
DB_SCHEMA_CHECK_ENABLED=true

# Persistent application state (must survive code upgrades)
FILE_UPLOAD_DIR=/var/lib/anomaly-detection-system/uploads

# Authentication and public origin
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=https://system.example.com
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCK_SECONDS=900

# DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-turbo
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2
AI_LLM_TIMEOUT_SECONDS=45
AI_LLM_MAX_RETRIES=2
AI_LLM_RETRY_BACKOFF_SECONDS=0.4
AI_LLM_CIRCUIT_FAILURE_THRESHOLD=5
AI_LLM_CIRCUIT_RECOVERY_SECONDS=30

# Qdrant
AI_VECTOR_STORE_PROVIDER=qdrant
AI_QDRANT_MODE=server
AI_QDRANT_URL=
AI_QDRANT_API_KEY=
AI_QDRANT_TIMEOUT_SECONDS=10
AI_QDRANT_PREFER_GRPC=false
AI_QDRANT_BATCH_SIZE=100

# RAG persistent state and safety gates
AI_RAG_ARTIFACT_PATH=/var/lib/anomaly-detection-system/knowledge
AI_RAG_EMBEDDING_CACHE_ENABLED=true
AI_RAG_EMBEDDING_CACHE_PATH=/var/lib/anomaly-detection-system/knowledge/cache/document_embeddings.sqlite3
AI_RAG_UPLOAD_SECURITY_ENABLED=true
AI_RAG_MALWARE_SCAN_ENABLED=true
AI_RAG_CLAMAV_PATH=/usr/bin/clamscan
AI_RAG_CLAMAV_VERSION=1.5.4
AI_RAG_CLAMAV_DATABASE_PATH=/var/lib/clamav
AI_RAG_CLAMAV_CERTS_PATH=
AI_RAG_CLAMAV_TIMEOUT_SECONDS=120
AI_RAG_CLAMAV_MAX_SIGNATURE_AGE_SECONDS=86400
AI_RAG_PARSER_ISOLATION_ENABLED=true
AI_RAG_PARSER_WALL_TIMEOUT_SECONDS=120
AI_RAG_PARSER_MEMORY_LIMIT_BYTES=1073741824
AI_RAG_PARSER_CPU_LIMIT_SECONDS=60
AI_RAG_OCR_ENABLED=true
AI_RAG_OCR_TESSERACT_PATH=/usr/bin/tesseract
AI_RAG_OCR_PDFTOPPM_PATH=/usr/bin/pdftoppm
AI_RAG_OCR_PDFINFO_PATH=/usr/bin/pdfinfo
AI_RAG_OCR_TESSDATA_PATH=/var/lib/anomaly-detection-system/knowledge/ocr/tessdata
AI_RAG_OCR_LANGUAGES=chi_sim+eng
AI_RAG_OCR_DPI=300
AI_RAG_OCR_TIMEOUT_SECONDS=120
AI_RAG_RELEASE_SMOKE_REQUIRED=true

# Optional local reranker remains disabled until a reviewed model is installed.
AI_RAG_RERANKER_ENABLED=false
AI_RAG_RERANKER_MODEL=

# Read-only GPU status account
GPU_SERVER_NAME=Primary GPU Server
GPU_SERVER_HOST=
GPU_SERVER_PORT=22
GPU_SERVER_SSH_USER=gpu_observer
GPU_SERVER_SSH_PASSWORD=
GPU_SERVER_PRIVATE_KEY_PATH=/etc/anomaly-detection-system/ssh/gpu_observer_key
GPU_SERVER_KNOWN_HOSTS_PATH=/etc/anomaly-detection-system/ssh/known_hosts
GPU_EXPECTED_COUNT=4
GPU_ACCOUNT_ROOT_TEMPLATE=/home/{username}
GPU_ACCOUNT_MAP_JSON={}
GPU_ACCOUNT_ALLOWED_DIRECTORIES_JSON={"projects":"/home/{username}/projects","datasets":"/data/{username}/datasets"}
GPU_CONDA_ENV_ROOTS_JSON={"conda":"/opt/conda/envs"}
GPU_ADDITIONAL_SERVERS_JSON=[]

# Remote training and inference are enabled only after deployment preflight passes.
TRAINING_EXECUTOR_ENABLED=false
TRAINING_SERVER_HOST=
TRAINING_SERVER_PORT=22
TRAINING_SERVER_SSH_USER=adtrainer
TRAINING_SERVER_PRIVATE_KEY_PATH=/etc/anomaly-detection-system/ssh/adtrainer_key
TRAINING_SERVER_KNOWN_HOSTS_PATH=/etc/anomaly-detection-system/ssh/known_hosts
TRAINING_REMOTE_CONTROL_ROOT=/home/adtrainer/training-control
TRAINING_REMOTE_OUTPUT_ROOT=/home/adtrainer/training-runs
TRAINING_REMOTE_RUNNER_PATH=/home/adtrainer/bin/phase0_pbas_runner_dataset_v2.py
TRAINING_GPU_ALLOWLIST=0,1,2,3
INFERENCE_REMOTE_RUNNER_PATH=/home/adtrainer/bin/phase0_pbas_inference_runner.py
INFERENCE_REMOTE_CONTROL_ROOT=/home/adtrainer/inference-control
INFERENCE_REMOTE_OUTPUT_ROOT=/home/adtrainer/inference-runs
